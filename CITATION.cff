    given-names: Alejandro
    orcid: "https://orcid.org/0000-0002-4175-7726"
  - family-names: Dominguez
    given-names: Christian
repository: "https://github.com/ajaramillomoreno/LightningRiskMX"
url: "https://ajaramillomoreno.github.io/projects/lightning-risk-mx/"
